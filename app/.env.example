# D:\crisis\app\.env  —— 不进 Git,密码从此处读取

DATABASE_URL=postgresql+psycopg://postgres:<密码>@localhost:5432/crisis
LOG_DIR=D:/crisis/logs
LOG_LEVEL=INFO
# 日志目录总量上限（字节），超出后循环删除/裁剪较旧内容
LOG_MAX_BYTES=524288000

# 采集开关 —— 需密钥的源默认关闭
ENABLE_USGS=true
ENABLE_GDACS=true
ENABLE_EMSC=true
ENABLE_EONET=true
ENABLE_GDELT=true
ENABLE_OPENMETEO=true
ENABLE_CMA=true
ENABLE_CENC=true
ENABLE_FIRMS=false
FIRMS_MAP_KEY=

# 轮询间隔(秒)
INTERVAL_USGS=120
INTERVAL_GDACS=360
INTERVAL_EONET=900
INTERVAL_GDELT=900
INTERVAL_OPENMETEO=21600
INTERVAL_CMA=300
INTERVAL_CENC=180

# 告警阈值 —— 按 category 分开,不跨类共用(见 8.6)
ALERT_EQ_GLOBAL_MAG=6.0
ALERT_EQ_LOCAL_MAG=4.5
ALERT_MUTE_MINUTES=30
ALERT_CONFLICT_MIN_CONFIDENCE=0.7
