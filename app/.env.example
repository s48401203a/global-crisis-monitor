# app/.env —— 不进 Git，密码只从此处读取（模板：cp app/.env.example app/.env）

DATABASE_URL=postgresql+psycopg://postgres:<密码>@localhost:5432/crisis
# 留空则默认仓库根目录 logs/；Windows 可写 D:/crisis/logs
LOG_DIR=
LOG_LEVEL=INFO
# 日志目录总量上限（字节），超出后循环删除/裁剪较旧内容
LOG_MAX_BYTES=524288000

# 采集开关 —— 需密钥的源默认关闭
ENABLE_USGS=true
ENABLE_GDACS=true
ENABLE_EMSC=true
ENABLE_EONET=true
ENABLE_GDELT=true
ENABLE_OPENMETEO=true
ENABLE_CMA=true
ENABLE_CENC=true
ENABLE_FIRMS=false
FIRMS_MAP_KEY=
# FIRMS 产品：VIIRS_SNPP_NRT | VIIRS_NOAA20_NRT | VIIRS_NOAA21_NRT | MODIS_NRT；只按 watch_region bbox 查询
FIRMS_SOURCE=VIIRS_SNPP_NRT

# 轮询间隔(秒)
INTERVAL_USGS=120
INTERVAL_GDACS=360
INTERVAL_EONET=900
INTERVAL_GDELT=900
INTERVAL_OPENMETEO=21600
INTERVAL_CMA=300
INTERVAL_CENC=180

# 告警阈值 —— 按 category 分开,不跨类共用(见 8.6)
ALERT_EQ_GLOBAL_MAG=5.0
ALERT_EQ_LOCAL_MAG=4.0
ALERT_MUTE_MINUTES=30
ALERT_CONFLICT_MIN_CONFIDENCE=0.7
# 聚合冲突信号（GDELT 国家×日）当日累计 ≥ N 起才告警
ALERT_CONFLICT_MIN_EVENTS=10

# 出站代理：env（沿用 HTTP_PROXY/HTTPS_PROXY 环境变量，默认）| direct（忽略环境直连）| url（用下面的地址）
# 2026-08 曾因环境里残留失效代理导致全部数据源静默中断；不确定时用 direct
HTTP_PROXY_MODE=env
HTTP_PROXY_URL=
# ≥ N 个已启用源同时异常 → 顶栏红显 degraded
PIPELINE_DEGRADED_MIN_SOURCES=2
# 启动后多少秒才开始评估告警（让回补先落库，避免重启告警风暴）
ALERT_STARTUP_GRACE_SECONDS=120

# 数据保留（天）：observation.raw 清空 / 告警删除 / deleted 事件物理删除 / 洪水样本
RETENTION_RAW_DAYS=90
RETENTION_ALERT_DAYS=180
RETENTION_DELETED_DAYS=30
RETENTION_SAMPLE_DAYS=400
